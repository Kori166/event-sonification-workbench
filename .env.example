# Root containing the MOT17 train and test directories.
MOT17_ROOT=

# Root containing the KITTI Tracking training and testing directories.
KITTI_TRACKING_ROOT=

# Root containing the retained Stage 2 evidence tree used by private Stage 3/4 integration tests.
# Expected dataset subtrees include mot17/run-a and kitti/run-a with events, cues and audio folders.
STAGE2_EVIDENCE_ROOT=

# Hosted deployment only. The Render service downloads one researcher-built retained bundle.
# The URL must use HTTPS. The SHA-256 is required and causes deployment to fail closed on mismatch.
WORKBENCH_BUNDLE_URL=
WORKBENCH_BUNDLE_SHA256=

# Optional local path used to test the hosted entry point without downloading the archive.
WORKBENCH_BUNDLE_PATH=
